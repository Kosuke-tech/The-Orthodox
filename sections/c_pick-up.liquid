{{ 'c_pick-up.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: calc({{ section.settings.padding-top_sp }}px);
    padding-bottom: calc({{ section.settings.padding-bottom_sp }}px);
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding-top_pc }}px;
      padding-bottom: {{ section.settings.padding-bottom_pc }}px;
    }
  }

  #shopify-section-{{ section.id }} {
    overflow: hidden;
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} page-width">
  <div class="c-pick-up">
    <div class="c-pick-up__textarea--wrapper">
      <div class="c-section-head c-pick-up__head">
        {% render 'c_section-title', title: section.settings.title, sub_title: section.settings.sub_title %}
      </div>
      <div>{{ section.settings.textarea }}</div>
      <button class="c-pick-up__textarea--button">
        <a href="">もっと見る</a>
      </button>
      <div class="splide__arrows">
        <button class="splide__arrow splide__arrow--prev">
          <img src="{{ 'c-icon_splide_arrow.svg' | asset_url }}" alt="Previous" width="20" height="20">
        </button>
        <button class="splide__arrow splide__arrow--next">
          <img src="{{ 'c-icon_splide_arrow.svg' | asset_url }}" alt="Next" width="20" height="20">
        </button>
      </div>
    </div>

    <div class="splide c_splide c-pick-up__content splide-{{ section.id }}">
      <div class="splide__track">
        <ul class="splide__list">
          {% for block in section.blocks %}
            <li class="splide__slide">
              {% if section.settings.url != blank %}<a href="{{ block.settings.url }}">{% endif %}
              <picture>
                {%- if block.settings.image_sp != blank %}
                  <source srcset="{{ block.settings.image_sp | image_url: width: 800}}" media="(max-width: 750px)">
                {% endif -%}
                <img
                  class="c-image c-pick-up__image"
                  src="{{ block.settings.image_pc | image_url: width: 1200 }}"
                  width="1200"
                  height="600"
                  alt="block.settings.image_pc.alt"
                >
              </picture>
              {%- if section.settings.url != blank %}</a>{% endif %}
            </li>
          {% endfor -%}
        </ul>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener( 'DOMContentLoaded', function() {

    const splideOptions = {
      type: 'loop',
      rewind: true,
      gap: {{settings.spacing_grid_horizontal}},
      perMove: 1,
      focus: 0,
      omitEnd: true,
      fixedWidth: 300,
      arrows: false,
      autoplay: false,
      breakpoints: {
        750: {
          fixedWidth: '100%',
          gap: 0,
        }
      }
    };

    var splide = new Splide( '.splide-{{section.id}}', splideOptions );

    const customPrev = document.querySelector('.section-{{ section.id }}-padding .splide__arrow--prev');
    const customNext = document.querySelector('.section-{{ section.id }}-padding .splide__arrow--next');

    if (customPrev && customNext) {
      customPrev.addEventListener('click', () => splide.go('<'));
      customNext.addEventListener('click', () => splide.go('>'));
    }

    splide.on('overflow', function(isOverflow) {
      splide.go(0);
      splide.options = {
        type: isOverflow ? 'loop' : 'slide',
        focus: isOverflow ? 'center' : undefined,
        drag: isOverflow,
        clones: isOverflow ? undefined : 0,
        arrows: false
      };
    });

    splide.mount();

    {% if request.design_mode %}
      document.addEventListener('shopify:section:load', function(e) {
        if (e.detail.sectionId === '{{ section.id }}') {
          if (splide) {
            splide.destroy();
          }
          splide = new Splide('.splide-{{ section.id }}', splideOptions);

          splide.on('overflow', function(isOverflow) {
            splide.go(0);
            splide.options = {
              type: isOverflow ? 'loop' : 'slide',
              focus: isOverflow ? 'center' : undefined,
              drag: isOverflow,
              clones: isOverflow ? undefined : 0,
              arrows: false
            };
          });

          splide.mount();
        }
      });
      document.addEventListener('shopify:block:select', function(e) {
        if (e.detail.sectionId === '{{ section.id }}') {
          const blockId = e.detail.blockId;

          const slides = Array.from(document.querySelectorAll('.splide-{{ section.id }} .splide__slide:not(.splide__slide--clone)'));

          const targetSlide = slides.find(slide => slide.dataset.blockId === blockId);

          if (targetSlide && splide) {
            const blockIndex = parseInt(targetSlide.dataset.blockIndex);
            splide.go(blockIndex);
          }
        }
      });
    {% endif %}
  } );
</script>
{% schema %}
{
  "name": "カスタム：ピックアップ",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "見出し",
      "default": "PICK UP PRODUCTS"
    },
    {
      "type": "text",
      "id": "sub_title",
      "label": "サブ見出し",
      "default": "ピックアップ プロダクト"
    },
    {
      "type": "textarea",
      "id": "textarea",
      "label": "テキストエリア",
      "default": "テキストを入力してください。"
    },
    {
      "type": "header",
      "content": "デスクトップ"
    },
    {
      "type": "range",
      "id": "padding-top_pc",
      "label": "セクションの上部の余白",
      "unit": "px",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-bottom_pc",
      "label": "セクションの下部の余白",
      "unit": "px",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 0
    },
    {
      "type": "header",
      "content": "モバイル"
    },
    {
      "type": "range",
      "id": "padding-top_sp",
      "label": "セクションの上部の余白",
      "unit": "px",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-bottom_sp",
      "label": "セクションの下部の余白",
      "unit": "px",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "画像",
      "settings": [
        {
          "type": "image_picker",
          "id": "image_pc",
          "label": "画像(PC)"
        },
        {
          "type": "image_picker",
          "id": "image_sp",
          "label": "画像(SP)"
        },
        {
          "type": "url",
          "id": "url",
          "label": "リンク"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "カスタム：ピックアップ"
    }
  ]
}
{% endschema %}
